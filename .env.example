# 개발용 기본 설정 — 실제 비밀 값으로 바꾸지 말 것 (시크릿은 .env에 둔다)
KP_DATABASE_URL=postgresql://palette:palette@127.0.0.1:54329/knowledge_palette
KP_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# OpenAI 호환 Chat Completions (로컬 Ollama 기본값)
KP_LLM_PROVIDER=openai-compatible
KP_LLM_BASE_URL=http://127.0.0.1:11434/v1
KP_LLM_API_KEY=
KP_CHAT_MODEL=qwen3.5:4b-mlx
# Ollama thinking을 끈다. 이 파라미터를 지원하지 않는 서비스에서는 비운다.
KP_LLM_REASONING_EFFORT=none
# 비우면 Chat 모델을 사용한다. Knowledge Update는 Phase 4에서 구현한다.
KP_KNOWLEDGE_MODEL=
